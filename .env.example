# MyContractIQ configuration (this file is git-ignored — never commit it)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-6-luna

# Optional: SMTP for welcome emails. If blank, emails are saved to output/outbox/ instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MyContractIQ <no-reply@mycontractiq.app>

# Optional: where data is stored. Leave blank locally. On Render, attach a persistent disk
# (e.g. mounted at /var/data) and set DATA_DIR=/var/data so the database, PDFs and audit
# trail survive redeploys. OUTPUT_DIR defaults to DATA_DIR/output.
DATA_DIR=
OUTPUT_DIR=
