# MyContractIQ configuration (this file is git-ignored — never commit it)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-6-luna

# Optional: SMTP for welcome emails. If blank, emails are saved to output/outbox/ instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MyContractIQ <no-reply@mycontractiq.app>
